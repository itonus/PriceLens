<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for Allegro Open API credentials.

  Copy this file to `PriceLens/Resources/Secrets.plist` and fill in your own values.
  `Secrets.plist` is gitignored and must never be committed.

  See docs/ALLEGRO_API_SETUP.md for how to obtain these.
  Without this file the app still builds and runs; Allegro simply falls back to a search link.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>clientID</key>
	<string></string>
	<key>clientSecret</key>
	<string></string>
	<key>userAgent</key>
	<string></string>
</dict>
</plist>
